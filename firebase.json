{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "pet-aggregator-app",
          "appId": "1:280616341211:android:5a31a2ae4cf59c558a46fe",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "pet-aggregator-app",
          "configurations": {
            "android": "1:280616341211:android:5a31a2ae4cf59c558a46fe",
            "ios": "1:280616341211:ios:492010fe17ad16958a46fe"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "pet-aggregator-app",
          "appId": "1:280616341211:ios:492010fe17ad16958a46fe",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "website/public",
    "predeploy": [
      "node website/check-placeholders.mjs"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
