rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A review's doc id IS its bookingId (one review per booking), so these can
    // look the booking up directly and confirm the author really is the paying
    // customer of that exact provider. exists() first: get() on a missing doc
    // errors out, and && short-circuits.
    function isMyPaidService(bookingId, targetId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId))
             && get(/databases/$(database)/documents/bookings/$(bookingId)).data.parentId == request.auth.uid
             && get(/databases/$(database)/documents/bookings/$(bookingId)).data.proId == targetId
             && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'confirmed';
    }
    function isMyPaidStay(bookingId, targetId) {
      return exists(/databases/$(database)/documents/homestayBookings/$(bookingId))
             && get(/databases/$(database)/documents/homestayBookings/$(bookingId)).data.guestId == request.auth.uid
             && get(/databases/$(database)/documents/homestayBookings/$(bookingId)).data.hostId == targetId
             && get(/databases/$(database)/documents/homestayBookings/$(bookingId)).data.status == 'paid';
    }

    // True when `blockerUid` has blocked `otherUid`.
    function hasBlocked(blockerUid, otherUid) {
      return exists(/databases/$(database)/documents/users/$(blockerUid)/blocked/$(otherUid));
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // A block list lives under its owner's doc, so the owner-only rule above
      // already keeps it private — nobody can discover who has blocked them.
      match /blocked/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Device push tokens. Owner-only: a token is effectively a handle for
      // sending someone notifications, so it must not be readable by others.
      // The Functions read these with the Admin SDK, which bypasses rules.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // A partner's own KYC application. They may submit and re-submit, but never
    // touch the review verdict — status is pinned to 'pending' on any client
    // write, so nobody can self-approve their way to a verified badge.
    match /verificationRequests/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy', 'reason']);
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['reviewedAt', 'reviewedBy', 'reason']);
      allow delete: if false;
    }

    // Payout account + earnings. Both are read-only to their owner and written
    // only by the server: the amounts come from server-computed booking prices,
    // and `razorpayAccountId` is what money is sent to. A client that could
    // write either could pay itself, or redirect someone else's earnings.
    match /payoutAccounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /payouts/{payoutId} {
      allow read: if request.auth != null && resource.data.partnerId == request.auth.uid;
      allow write: if false;
    }

    // Admin-only collections. Denied to every client outright — a client that
    // could write adminRoles could grant itself admin, and an audit log a client
    // can edit is not an audit log. Both are Admin SDK only.
    match /adminRoles/{email} {
      allow read, write: if false;
    }
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // Write-only from the app: a client files a report but can never read the
    // queue back, so reports cannot be enumerated or edited to look handled.
    // The admin panel (plan.md Phase 12) reads this with the Admin SDK.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'open';
      allow update, delete: if false;
    }
    match /pets/{petId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }
    match /swipes/{swipeId} {
      allow read: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
                  && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }
    // `verified`, `rating` and `reviewCount` are server-owned. The old rules let
    // ANY signed-in user update them as long as the write touched nothing else,
    // so a two-line script could set any pro's rating to 5.0; and the blanket
    // owner-write let a pro grant themselves the "Pawgo Verified" badge by
    // writing Firestore directly. Both are now rejected for every client:
    // ratings are written only by the onReviewCreated Function and `verified`
    // only by staff (both Admin SDK, which bypasses rules).
    match /pros/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['verified', 'rating', 'reviewCount']);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['verified', 'rating', 'reviewCount']);
      allow delete: if false;
    }
    match /bookings/{id} {
      allow read: if request.auth != null
                  && (resource.data.parentId == request.auth.uid
                      || resource.data.proId == request.auth.uid);
      allow create: if request.auth != null
                  && request.resource.data.parentId == request.auth.uid
                  && request.resource.data.status == 'pending';
      // Only an UNPAID booking may be cancelled from the client. 'confirmed'
      // means the customer has paid, and this rule used to allow cancelling it
      // — which silently kept their money and left the pro's payout in place
      // for a service that never happened. A paid cancellation now has to go
      // through refundBookingPayment, which refunds and reverses the payout in
      // one place (Admin SDK, so it bypasses this rule).
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && resource.data.parentId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }
    // Same server-owned fields as /pros — see the note there.
    match /homestays/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['verified', 'rating', 'reviewCount']);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['verified', 'rating', 'reviewCount']);
      allow delete: if false;
    }
    match /homestayBookings/{id} {
      allow read: if request.auth != null
                  && (resource.data.guestId == request.auth.uid
                      || resource.data.hostId == request.auth.uid);
      allow create: if request.auth != null
                  && request.resource.data.guestId == request.auth.uid
                  && request.resource.data.status == 'requested';
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && (
                      (resource.data.hostId == request.auth.uid
                        && resource.data.status == 'requested'
                        && request.resource.data.status in ['accepted', 'declined'])
                      || (resource.data.guestId == request.auth.uid
                        && resource.data.status in ['requested', 'accepted']
                        && request.resource.data.status == 'cancelled')
                    );
      allow delete: if false;
    }
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']);
      allow delete: if false;
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /chats/{chatId} {
      // resource == null lets openChat's get-or-create probe a not-yet-created
      // chat (a missing doc leaks nothing; chat ids are deterministic anyway).
      allow read: if request.auth != null
                  && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Blocking is filtered client-side everywhere else, which only hides
        // content. Here it is genuinely enforced: "they can still message me"
        // is the failure that actually matters, so a blocked sender is rejected
        // by the server rather than by the app.
        allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                    && !hasBlocked(
                         get(/databases/$(database)/documents/chats/$(chatId))
                           .data.participants.removeAll([request.auth.uid])[0],
                         request.auth.uid);
        allow update, delete: if false;
      }
    }
    // The doc id is the bookingId, which is what makes "one review per booking"
    // enforceable here rather than only in client code. Previously any signed-in
    // user could review anyone they had never booked (and review themselves);
    // now the write must be backed by their own paid booking with that exact
    // provider. Note this checks the booking was PAID, not that it has finished
    // — "completed" is derived from calendar dates (see booking_lifecycle.dart)
    // and is impractical to recompute in rules, so the client still owns that
    // part. Reviewing your own paid booking a day early is a far smaller problem
    // than reviewing a stranger.
    match /reviews/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.bookingId == bookingId
                    && (
                      (request.resource.data.targetType == 'pro'
                        && isMyPaidService(bookingId, request.resource.data.targetId))
                      || (request.resource.data.targetType == 'homestay'
                        && isMyPaidStay(bookingId, request.resource.data.targetId))
                    );
      allow update, delete: if false;
    }
  }
}
