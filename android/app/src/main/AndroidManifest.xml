<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ requires this at runtime; without it every push is dropped
         silently, with no error anywhere. PushService asks for it on sign-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="Pawgo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Without an explicit channel, Android 8+ drops notifications that
             arrive while the app is backgrounded. FCM creates this one on demand. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="pawgo_default" />
        <!-- The status-bar icon must be a white-on-transparent silhouette; the
             full-colour launcher icon renders as a grey square. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/pawgo_brand" />
        <!-- ACTION REQUIRED: this key is still restricted to the OLD package
             (com.example.pet_aggregator_app) + the debug SHA-1, so the Nearby map
             will fail to load until the restriction is updated in Google Cloud
             Console → Credentials → this key → Android restrictions. Add both:
               com.pawgo.app : 6E:D8:EF:EB:70:31:9A:95:98:9C:CC:0D:E8:0B:61:E3:E4:7A:60:D5
               com.pawgo.app : 48:31:E5:13:AA:ED:B2:4F:2E:BB:F2:30:05:BD:38:05:53:20:96:9B
             The second is the release keystore's SHA-1 (android/app/pawgo-release.jks). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBbEEoDT0x6i44ENxXRAGIV0i9zziaYItQ" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
