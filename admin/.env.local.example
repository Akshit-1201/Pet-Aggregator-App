# Copy to .env.local (git-ignored) and fill from a service-account key:
#   Firebase Console -> Project settings -> Service accounts -> Generate new private key
#
# The downloaded JSON has these three fields. Keep the private key on ONE line
# with literal \n escapes exactly as it appears in the JSON — the app unescapes them.
FIREBASE_PROJECT_ID=pet-aggregator-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pet-aggregator-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Needed for signed URLs on KYC documents.
FIREBASE_STORAGE_BUCKET=pet-aggregator-app.firebasestorage.app
